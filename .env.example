# Copia este archivo a .env y completa los valores. NUNCA subas .env a git.

# Server-only: la usa src/server/gemini.ts (rutas app/api/*+api.ts).
GEMINI_API_KEY=

# URL pública de tu API desplegada (EAS Hosting). Déjalo vacío en desarrollo local.
EXPO_PUBLIC_API_BASE_URL=

# Token compartido entre la app y el servidor (src/server/guard.ts). Usa el
# MISMO valor en las dos. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# EXPO_PUBLIC_APP_TOKEN también debe existir como secreto en GitHub Actions.
APP_TOKEN=
EXPO_PUBLIC_APP_TOKEN=
