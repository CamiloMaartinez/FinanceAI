@startuml 03b_actividades_arranque_autenticacion
!include _estilo.iuml
title Diagrama de actividades – Arranque de la aplicación y autenticación (CU-001)

start
:Mostrar splash con barra de progreso real;
:Leer perfil activo y abrir su\narchivo SQLite (switchDatabase);
:Crear tablas / aplicar migraciones\ny sembrar categorías por defecto;
:Generar movimientos recurrentes pendientes;
:Procesar aportes automáticos a metas;
:Avanzar fechas de suscripciones ya cobradas;
:Evaluar alertas y presupuesto del mes\n(notificar si una categoría llega al 80 %);
fork
  :Programar recordatorio de respaldo;
fork again
  :Actualizar tasas de cambio\n(si pasaron más de 12 h y hay internet);
end fork
note right: Estas dos tareas no bloquean el arranque
if (¿El perfil ya vio el onboarding?) then (no)
  repeat
    :Mostrar tarjeta del onboarding;
  repeat while (¿Quedan tarjetas?) is (sí) not (no)
  :Marcar onboarding como visto;
else (sí)
endif
if (¿El teléfono tiene biometría\ndisponible y configurada?) then (sí)
  :Mostrar pantalla de bloqueo;
  repeat
    if (¿Usuario elige PIN?) then (sí)
      :Leer PIN de 4 dígitos;
      :Comparar con el PIN en SecureStore;
    else (no)
      :Solicitar Face ID / huella al\nsistema operativo;
    endif
  repeat while (¿Validación correcta?) is (no: mostrar error) not (sí)
  :Abrir candado y cortina de marca;
else (no)
endif
:Mostrar Dashboard (Inicio);
stop
@enduml
