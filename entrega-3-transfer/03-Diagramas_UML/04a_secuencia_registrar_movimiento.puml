@startuml 04a_secuencia_registrar_movimiento
!include _estilo.iuml
title Diagrama de secuencia – Registrar un movimiento (CU-003)
autonumber
actor Usuario as U
participant "TransactionForm\n<<vista>>" as F
participant "useTransactions\n<<viewmodel>>" as VM
participant "db.ts\n<<fachada de datos>>" as DB
database "SQLite\n(teléfono)" as SQL

U -> F : Toca «Gasto», digita monto y desliza
F -> F : validar monto > 0
U -> F : Elige categoría, nota y toca «Guardar»
F -> F : handleSave(): construir TransactionInput
alt monto inválido
  F --> U : «Ingresa un monto válido»
else datos válidos
  F -> VM : addTransaction(input, recurrence, splitWith)
  activate VM
  alt dividir gasto (splitWith no vacío)
    VM -> DB : createSplitExpense(input, personas)
  else gasto normal
    VM -> DB : createTransaction(input)
    activate DB
    DB -> SQL : BEGIN (withTransactionAsync)
    DB -> SQL : INSERT INTO transactions (...)
    DB -> SQL : UPDATE accounts SET balance = balance - monto
    DB -> SQL : COMMIT
    SQL --> DB : ok
    deactivate DB
  end
  opt repetir (semanal / quincenal / mensual)
    VM -> DB : createRecurring(input, frecuencia, fecha)
    DB -> SQL : INSERT INTO recurring_transactions
  end
  VM -> DB : getAllTransactionsWithCategory()
  DB -> SQL : SELECT ... JOIN categories, accounts
  SQL --> DB : filas
  DB --> VM : TransactionWithCategory[]
  VM --> F : estado actualizado
  deactivate VM
  F --> U : Cierra el formulario; el gasto aparece en «Hoy»
end
@enduml
