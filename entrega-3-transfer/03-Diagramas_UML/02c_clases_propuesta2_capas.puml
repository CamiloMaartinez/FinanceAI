@startuml 02c_clases_propuesta2_capas
!include _estilo.iuml
title Diagrama de clases – Propuesta 2 (seleccionada): Vista, ViewModel, Servicios y Datos (MVVM)
skinparam linetype polyline
hide empty members
left to right direction

package "Vista (app/ – Expo Router)" as V {
  class TransactionsScreen <<pantalla>>
  class AssistantScreen <<pantalla>>
  class BudgetsScreen <<pantalla>>
  class ReportsScreen <<pantalla>>
  class ProfileScreen <<pantalla>>
  class LockScreen <<componente>> {
    - mode : 'faceid' | 'pin'
    - failedOnce : boolean
    + onUnlock() : void
  }
  class TransactionForm <<componente>> {
    - amount : string
    - type : TransactionType
    - accountId : string
    - categoryId : string | null
    + handleSave() : void
  }
}

package "ViewModel (src/hooks)" as VM {
  class useTransactions <<hook>> {
    + transactions : TransactionWithCategory[]
    + accounts : Account[]
    + categories : Category[]
    + isLoading : boolean
    + error : string | null
    + addTransaction(input : TransactionInput) : Promise<void>
    + editTransaction(id : string, input : TransactionInput) : Promise<void>
    + removeTransaction(id : string) : Promise<void>
    + refresh() : Promise<void>
  }
  class useFinancialAssistant <<hook>> {
    + messages : ChatMessage[]
    + isLoading : boolean
    + error : string | null
    + sendMessage(question : string) : Promise<void>
    + evaluatePurchase(item : string, price : number) : Promise<void>
    - buildFinancialContext() : FinancialContext
  }
  class useBudgets <<hook>> {
    + budget : Budget | null
    + totalLimit : number
    + totalSpent : number
    + totalPercent : number
    + categories : BudgetRow[]
    + saveBudget(...) : Promise<void>
    + suggestWithAI() : Promise<void>
  }
}

package "Servicios (src/services)" as SV {
  interface IAIClient <<interfaz>> {
    + askFinancialAssistant(q : string, ctx : FinancialContext) : Promise<string>
    + evaluatePurchase(item : string, price : number, ctx) : Promise<PurchaseEvaluation>
    + suggestBudget(history) : Promise<BudgetSuggestion>
  }
  class AIService <<ai.ts>> {
    - API_BASE_URL : string
    - APP_TOKEN : string
    - postJson<T>(path : string, body) : Promise<T>
  }
  class ReceiptScanner <<receiptScanner.ts>> {
    + scanReceipt(base64 : string) : Promise<ScannedReceipt>
  }
  class BiometricAuth <<biometricAuth.ts>> {
    + isBiometricAvailable() : Promise<boolean>
    + authenticateWithBiometrics() : Promise<boolean>
  }
  class PinAuth <<pinAuth.ts>> {
    + hasPinSet() : Promise<boolean>
    + setPin(pin : string) : Promise<void>
    + verifyPin(pin : string) : Promise<boolean>
  }
  class NotificationService <<notifications.ts>> {
    + scheduleSubscriptionReminders(sub : Subscription) : Promise<void>
  }
  class AlertEngine <<alertEngine.ts>> {
    + evaluateAlerts() : Promise<void>
    + getMonthInsights(today : Date) : Promise<CategoryInsight[]>
  }
  class ExchangeRates <<exchangeRates.ts>> {
    + getExchangeRates() : Promise<Record<string, number>>
    + refreshExchangeRates(force? : boolean) : Promise<RefreshResult>
    + convertBetween(v, from, to, rates) : number
  }
  class BackupService <<backup.ts>> {
    + exportBackup() : Promise<void>
    + pickBackupFile() : Promise<BackupFile | null>
    + restoreBackup(data : BackupData) : Promise<void>
  }
  class PdfExport <<pdfExport.ts>>
  class CsvExport <<csvExport.ts>>
}

package "Datos (src/database/db.ts)" as DB {
  class Database <<fachada>> {
    + getDb() : Promise<SQLiteDatabase>
    + switchDatabase(fileName : string) : Promise<void>
    + createTransaction(input : TransactionInput) : Promise<void>
    + updateTransaction(id, input) : Promise<void>
    + deleteTransaction(id) : Promise<void>
    + getAllAccounts() : Promise<Account[]>
    + getBudgetForMonth(m, y) : Promise<Budget | null>
    + upsertBudget(...) : Promise<void>
    + processDueRecurring(now) : Promise<number>
  }
  class SQLiteDatabase <<expo-sqlite>> {
    + runAsync(sql, params)
    + getAllAsync<T>(sql, params)
    + withTransactionAsync(fn)
  }
}

package "Utilidades puras (src/utils)" as UT {
  class budgetCalculations {
    + getBudgetPercent(spent, limit) : number
    + getBudgetProgressColor(percent : number) : string
  }
  class recurrence {
    + nextOccurrence(...) : Date
    + dueOccurrences(...) : Date[]
  }
  class currency {
    + formatCurrency(value : number) : string
  }
}

package "Servidor (app/api – EAS Hosting)" as SRV {
  class ApiRoutes <<+api.ts>> {
    + POST /api/assistant
    + POST /api/scan-receipt
    + POST /api/evaluate-purchase
    + POST /api/suggest-budget
  }
  class Guard <<guard.ts>> {
    - RATE_LIMIT_MAX_REQUESTS = 20
    + guardRequest(req : Request, maxBytes : number) : Response | null
  }
  class GeminiClient <<gemini.ts>> {
    - callGeminiWithRetry(contents, maxTokens, temp, retries = 3) : Promise<string>
  }
}

TransactionsScreen --> useTransactions
ReportsScreen ..> PdfExport
ProfileScreen ..> CsvExport
ProfileScreen ..> BackupService
TransactionForm --> useTransactions
AssistantScreen --> useFinancialAssistant
BudgetsScreen --> useBudgets
LockScreen --> BiometricAuth
LockScreen --> PinAuth
TransactionForm --> ReceiptScanner

useTransactions --> Database
useBudgets --> Database
useBudgets ..> budgetCalculations
useFinancialAssistant --> Database
useFinancialAssistant --> IAIClient
IAIClient <|.. AIService
AlertEngine --> Database
AlertEngine --> NotificationService
BackupService --> Database
Database *-- "1" SQLiteDatabase
Database ..> recurrence
TransactionForm ..> ExchangeRates
TransactionsScreen ..> currency

AIService ..> ApiRoutes : HTTPS + x-app-token
ReceiptScanner ..> ApiRoutes : HTTPS
ApiRoutes --> Guard
ApiRoutes --> GeminiClient

@enduml
