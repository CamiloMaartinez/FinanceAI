@startuml 04c_secuencia_desbloqueo
!include _estilo.iuml
title Diagrama de secuencia – Desbloqueo con biometría y PIN de respaldo (CU-001)
autonumber
actor Usuario as U
participant "RootLayout\n(app/_layout.tsx)" as L
participant "LockScreen\n<<vista>>" as LS
participant "biometricAuth.ts" as BA
participant "pinAuth.ts" as PA
participant "Sistema operativo\n(Face ID / huella)" as SO
database "SecureStore\n(Keychain / Keystore)" as SS

U -> L : Abre la aplicación
L -> BA : isBiometricAvailable()
BA -> SO : hasHardwareAsync() y isEnrolledAsync()
SO --> BA : true
BA --> L : true
L -> LS : mostrar pantalla de bloqueo
LS -> PA : hasPinSet()
PA -> SS : getItemAsync(PIN_KEY)
SS --> PA : PIN guardado
PA --> LS : true (mostrar «Usar PIN»)
U -> LS : Toca «Desbloquear»
LS -> BA : authenticateWithBiometrics()
BA -> SO : authenticateAsync()
alt biometría correcta
  SO --> BA : success
  BA --> LS : true
else biometría falla
  SO --> BA : fallo
  BA --> LS : false
  LS --> U : «¿Falló Face ID? Usar PIN»
  U -> LS : Toca «Usar PIN» y digita 4 dígitos
  LS -> PA : verifyPin(pin)
  PA -> SS : getItemAsync(PIN_KEY)
  SS --> PA : PIN guardado
  alt PIN correcto
    PA --> LS : true
  else PIN incorrecto
    PA --> LS : false
    LS --> U : «PIN incorrecto. Intenta de nuevo.»\n(reinicia el teclado)
  end
end
LS -> L : onUnlock()
L --> U : Cortina de marca y Dashboard
@enduml
