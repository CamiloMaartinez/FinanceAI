@startuml 05c_estados_suscripcion
!include _estilo.iuml
title Diagrama de estados – Suscripción

[*] --> Activa : crear suscripción /\nprogramar recordatorios 7, 3 y 1 día antes
state Activa {
  [*] --> EsperandoCobro
  EsperandoCobro --> PorCobrar : faltan ≤ 7 días /\nnotificación
  PorCobrar --> PorCobrar : faltan 3 y 1 día /\nnotificación
  PorCobrar --> Cobrada : llega nextBillingDate
  Cobrada --> EsperandoCobro : al abrir la app /\navanzar nextBillingDate según la frecuencia\n(respeta el día ancla: 31 → 28 feb → 31 mar)
}
Activa --> Activa : editar monto o fecha /\nreprogramar recordatorios
Activa --> [*] : eliminar /\ncancelar recordatorios
@enduml
