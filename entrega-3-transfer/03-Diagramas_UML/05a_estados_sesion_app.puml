@startuml 05a_estados_sesion_app
!include _estilo.iuml
title Diagrama de estados – Sesión de la aplicación

[*] --> Arrancando : abrir la app
state Arrancando {
  [*] --> AbriendoBase
  AbriendoBase : abrir SQLite del perfil activo
  AbriendoBase --> Procesando : migraciones y categorías listas
  Procesando : recurrentes, metas, suscripciones, alertas
  Procesando --> [*]
}
Arrancando --> Onboarding : [perfil sin onboarding]
Arrancando --> Bloqueada : [onboarding visto y\nhay biometría]
Arrancando --> Desbloqueada : [onboarding visto y\nsin biometría]
Onboarding --> Bloqueada : Empezar [hay biometría]
Onboarding --> Desbloqueada : Empezar [sin biometría]

state Bloqueada {
  [*] --> EsperandoBiometria
  EsperandoBiometria --> IngresandoPIN : falla Face ID /\n«Usar PIN»
  IngresandoPIN --> EsperandoBiometria : «Usar Face ID»
  IngresandoPIN --> IngresandoPIN : PIN incorrecto /\nmostrar error
}
Bloqueada --> Desbloqueada : validación correcta /\ncortina de marca

state Desbloqueada {
  [*] --> Navegando
  Navegando --> EditandoRegistro : abrir formulario u hoja
  EditandoRegistro --> Navegando : guardar / cancelar
  Navegando --> CambiandoPerfil : elegir otro perfil
  CambiandoPerfil --> Navegando : base del perfil abierta
}
Desbloqueada --> [*] : el sistema cierra la app
@enduml
