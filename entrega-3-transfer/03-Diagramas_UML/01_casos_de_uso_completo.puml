@startuml 01_casos_de_uso_completo
!include _estilo.iuml
title Diagrama de casos de uso – Smart Finance (versión 2B corregida)
left to right direction
actor "Usuario" as U
actor "Sistema biométrico\n(iOS / Android)" as BIO <<sistema>>
actor "Servicio de IA\n(servidor + Gemini)" as IA <<sistema>>
actor "Servicio de tasas\nde cambio" as TAS <<sistema>>
actor "Notificaciones\ndel sistema" as NOT <<sistema>>
actor "Entidad bancaria\n(extracto CSV / SMS)" as BAN <<sistema>>
actor "Atajos de iOS / Siri" as ATA <<sistema>>
rectangle "Smart Finance (aplicación móvil)" {
  package "Seguridad" {
    usecase "CU-001 Autenticarse con\nvalidación biométrica" as CU1
    usecase "CU-001.1 Ingresar PIN\nde respaldo" as PIN
    usecase "CU-013 Gestionar perfiles" as CU13
  }
  package "Cuentas y movimientos" {
    usecase "CU-004 Gestionar cuentas\n(bancos, billeteras, efectivo)" as CU4
    usecase "CU-003 Registrar movimiento\n(sin conexión)" as CU3
    usecase "CU-002 Escanear recibo\ncon IA" as CU2
    usecase "CU-003.1 Dividir gasto\ncon otros" as DIV
    usecase "CU-003.2 Convertir moneda\n(COP / USD / EUR)" as CONV
    usecase "CU-016 Transferir\nentre cuentas" as TR
    usecase "CU-017 Programar movimiento\nrecurrente" as REC
    usecase "CU-015 Importar extracto\nbancario (CSV)" as CU15
    usecase "CU-018 Registrar movimiento\ndesde mensaje del banco" as CU18
  }
  package "Planificación" {
    usecase "CU-008 Gestionar\npresupuesto mensual" as CU8
    usecase "CU-009 Gestionar metas\nde ahorro" as CU9
    usecase "CU-009.1 Programar aporte\nautomático a meta" as AUT
    usecase "CU-010 Gestionar deudas\ny préstamos" as CU10
    usecase "CU-010.1 Registrar abono\na una deuda" as ABO
    usecase "CU-011 Configurar alertas" as CU11
  }
  package "Suscripciones" {
    usecase "CU-005 Configurar suscripciones\ny recordatorios" as CU5
  }
  package "Asistencia con IA" {
    usecase "CU-006 Consultar al\nasistente financiero" as CU6
    usecase "CU-014 Evaluar una compra\n(¿Puedo comprarlo?)" as CU14
    usecase "CU-008.1 Sugerir\npresupuesto con IA" as SUG
    usecase "CU-006.1 Construir contexto\nfinanciero" as CTX
  }
  package "Reportes y datos" {
    usecase "CU-007 Generar y compartir\nreportes" as CU7
    usecase "CU-007.1 Exportar\nPDF / CSV" as EXP
    usecase "CU-012 Respaldar y\nrestaurar datos" as CU12
  }
}
U --> CU1
U --> CU13
U --> CU4
U --> CU3
U --> TR
U --> REC
U --> CU15
U --> CU18
U --> CU7
U --> CU12
U --> CU8
PIN .> CU1 : <<extend>>\n(falla la biometría)
CU2 .> CU3 : <<extend>>\n(adjuntar recibo)
DIV .> CU3 : <<extend>>
CU3 ..> CONV : <<include>>
TR ..> CONV : <<include>>
CU18 .> CU3 : <<extend>>\n(precarga el formulario)
CU7 ..> EXP : <<include>>
CU1 --> BIO
CU2 --> IA
CONV --> TAS
CU12 --> NOT
BAN --> CU15
BAN --> CU18
ATA --> CU18

U --> CU9
U --> CU10
U --> CU11
U --> CU5
U --> CU6
U --> CU14
AUT .> CU9 : <<extend>>
ABO .> CU10 : <<extend>>
SUG .> CU8 : <<extend>>
CU6 ..> CTX : <<include>>
CU14 ..> CTX : <<include>>
CU6 --> IA
CU14 --> IA
SUG --> IA
CU5 --> NOT
CU11 --> NOT
CU8 --> NOT
CU10 --> NOT

note as N1
  Numeración alineada con la tabla de casos de uso:
  CU-002 = Escanear recibo y CU-004 = Gestionar cuentas.
end note
@enduml
