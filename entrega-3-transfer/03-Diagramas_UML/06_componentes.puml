@startuml 06_componentes
!include _estilo.iuml
title Diagrama de componentes – Smart Finance
skinparam componentStyle uml2
left to right direction

node "Teléfono (iOS / Android)" {
  package "App Smart Finance (React Native + Expo SDK 57)" {
    component "Vistas\n(app/ – Expo Router)" as VIS
    component "Componentes de interfaz\n(src/components, ui)" as UI
    component "ViewModels\n(src/hooks)" as VM
    component "Servicios\n(src/services)" as SRV
    component "Cálculos puros\n(src/utils)" as UTL
    component "Acceso a datos\n(src/database/db.ts)" as DAO
    interface "TransactionInput /\nmodelos (types.ts)" as IMOD
  }
  database "SQLite\n(un archivo por perfil)" as SQL
  database "AsyncStorage\n(preferencias, perfiles)" as AS
  database "SecureStore\n(PIN cifrado)" as SS
  folder "Sistema de archivos\n(fotos de recibos, avatar)" as FS
  component "Módulos nativos Expo\n(cámara, biometría, notificaciones,\nprint, sharing, haptics)" as NAT
}

cloud "EAS Hosting (servidor sin estado)" {
  component "Rutas API\n(app/api/*+api.ts)" as API
  component "guard.ts\n(token, límite, tamaño)" as GRD
  component "gemini.ts\n(cliente con reintentos)" as GEM
  interface "REST /api/*\n(HTTPS + JSON)" as IREST
}

cloud "Servicios externos" {
  component "Google Gemini API" as GAPI
  component "open.er-api.com\n(tasas de cambio)" as RATES
}

cloud "GitHub" {
  component "Repositorio Git" as GIT
  component "GitHub Actions\n(pruebas, .ipa, .apk)" as CI
}

VIS --> UI
VIS --> VM
VM --> SRV
VM --> DAO
VM ..> UTL
SRV ..> UTL
DAO -- IMOD
VM ..> IMOD
DAO --> SQL
SRV --> AS
SRV --> SS
SRV --> FS
SRV --> NAT
SRV --( IREST
IREST -- API
API --> GRD
API --> GEM
GEM --> GAPI : HTTPS\n(API key solo aquí)
SRV --> RATES : HTTPS
GIT --> CI
CI ..> API : despliegue (eas deploy)
CI ..> NAT : compilación nativa
@enduml
