@startuml 02a_clases_propuesta1_dominio_rico
!include _estilo.iuml
title Diagrama de clases – Propuesta 1: modelo de dominio rico con herencia (POO clásica)
skinparam linetype polyline
skinparam nodesep 25
skinparam ranksep 40
hide empty members

package "dominio.seguridad" {
  class Usuario {
    - id : String
    - nombre : String
    - pinCifrado : String
    - biometriaActiva : Boolean
    + autenticar(metodo : MetodoAutenticacion) : Boolean
    + cambiarPin(actual : String, nuevo : String) : void
  }
  interface IAutenticador {
    + autenticar() : Boolean
  }
  class AutenticadorBiometrico implements IAutenticador
  class AutenticadorPin implements IAutenticador {
    - intentosFallidos : Integer
  }
}

package "dominio.cuentas" {
  abstract class Cuenta {
    # id : String
    # nombre : String
    # saldo : Decimal
    # moneda : Moneda
    + depositar(monto : Decimal) : void
    + retirar(monto : Decimal) : void
    + {abstract} puedeRetirar(monto : Decimal) : Boolean
    + saldoEnPesos(tasas : TasaCambio) : Decimal
  }
  class CuentaAhorros extends Cuenta
  class CuentaCorriente extends Cuenta
  class Efectivo extends Cuenta
  class BilleteraDigital extends Cuenta {
    - proveedor : String
  }
  class TarjetaCredito extends Cuenta {
    - cupo : Decimal
    - tasaInteres : Decimal
    + cupoDisponible() : Decimal
  }
  enum Moneda {
    COP
    USD
    EUR
  }
}

package "dominio.movimientos" {
  abstract class Movimiento {
    # id : String
    # monto : Decimal
    # fecha : Date
    # nota : String
    + {abstract} aplicar() : void
    + {abstract} revertir() : void
  }
  class Ingreso extends Movimiento
  class Gasto extends Movimiento {
    + dividir(personas : List<String>) : List<Deuda>
  }
  class Transferencia extends Movimiento {
    - montoDestino : Decimal
  }
  class Categoria {
    - nombre : String
    - icono : String
    - color : String
  }
  class Recibo {
    - rutaFoto : String
    - comercio : String
  }
  class MovimientoRecurrente {
    - frecuencia : Frecuencia
    - proximaFecha : Date
    + generarPendientes(hoy : Date) : List<Movimiento>
  }
}

package "dominio.planificacion" {
  class Presupuesto {
    - mes : Integer
    - anio : Integer
    - limiteTotal : Decimal
    + porcentajeUsado() : Decimal
    + estado() : EstadoSemaforo
  }
  class LimiteCategoria {
    - limite : Decimal
  }
  class Meta {
    - objetivo : Decimal
    - ahorrado : Decimal
    - fechaLimite : Date
    + abonar(monto : Decimal) : void
    + aporteSemanalSugerido() : Decimal
  }
  class Deuda {
    - persona : String
    - monto : Decimal
    + abonar(pago : PagoDeuda) : void
    + pendiente() : Decimal
  }
  class PagoDeuda
  class Suscripcion {
    - costo : Decimal
    - frecuencia : Frecuencia
    - proximoCobro : Date
    + avanzarCobro() : void
    + costoAnual() : Decimal
  }
  class Alerta {
    - tipo : TipoAlerta
    - umbral : Decimal
    + evaluar() : Boolean
  }
}

package "persistencia" {
  interface "IRepositorio<T>" as IRepo {
    + guardar(e : T) : void
    + buscar(id : String) : T
    + listar() : List<T>
    + eliminar(id : String) : void
  }
  class RepositorioCuentas implements IRepo
  class RepositorioMovimientos implements IRepo
  class RepositorioMetas implements IRepo
  class UnidadDeTrabajo {
    + ejecutar(op : Funcion) : void
  }
}

package "servicios" {
  interface IServicioIA {
    + preguntar(pregunta : String, contexto : Contexto) : String
    + leerRecibo(imagen : Bytes) : Recibo
  }
  class ServicioGemini implements IServicioIA
}

Usuario "1" *-- "1..*" Cuenta : posee >
Usuario "1" o-- "1..2" IAutenticador
Cuenta "1" <-- "0..*" Movimiento : origen
Transferencia "0..*" --> "1" Cuenta : destino
Movimiento "0..*" --> "0..1" Categoria
Movimiento "1" *-- "0..1" Recibo
MovimientoRecurrente ..> Movimiento : <<crea>>
Presupuesto "1" *-- "0..*" LimiteCategoria
LimiteCategoria "0..*" --> "1" Categoria
Usuario "1" *-- "0..*" Meta
Deuda "1" *-- "0..*" PagoDeuda
Gasto ..> Deuda : <<crea>>
Usuario "1" *-- "0..*" Suscripcion
Usuario "1" *-- "0..*" Alerta
RepositorioMovimientos --> UnidadDeTrabajo
ServicioGemini ..> Recibo : <<crea>>

' Distribución en filas (enlaces ocultos)
AutenticadorPin -[hidden]down-> Moneda
Efectivo -[hidden]down-> Presupuesto
ServicioGemini -[hidden]down-> Categoria
Recibo -[hidden]down-> IRepo
@enduml
